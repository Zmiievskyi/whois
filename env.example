# Provider Discovery Tool - Environment Configuration
# Copy this file to .env and set your actual values

# VirusTotal API Configuration
VT_API_KEY=your-virustotal-api-key-here
VT_PREMIUM=false
VT_TIMEOUT=30
VT_CACHE_TTL=3600

# Application Settings
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CACHE_SIZE=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
VT_RATE_LIMIT_CALLS=4
VT_RATE_LIMIT_WINDOW=60

# Performance Settings
DNS_TIMEOUT=10
HTTP_TIMEOUT=10
WHOIS_TIMEOUT=15

# Feature Flags
ENABLE_DNS_ANALYSIS=true
ENABLE_VIRUSTOTAL=true
ENABLE_CACHING=true

# Streamlit Configuration (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# =============================================================================
# Censys API Configuration (Phase 3B: Shodan Alternative)
# =============================================================================

# Censys API Credentials
# Get your free API credentials from: https://search.censys.io/account/api
# Free tier: 250 queries per month, rate limited
# Academic: Higher limits for research
CENSYS_API_ID=your-censys-api-id-here
CENSYS_API_SECRET=your-censys-api-secret-here

# Cache TTL for Censys responses (seconds)
# Default: 7200 (2 hours) - longer than VT due to rate limits
CENSYS_CACHE_TTL=7200

# Rate limiting for Censys API (requests per minute)
# Free tier: Conservative rate limiting
# Academic/Paid: Higher limits
CENSYS_RATE_LIMIT=10

# =============================================================================
# Shodan API Configuration (Phase 3B: Premium WAF Detection)
# =============================================================================

# Shodan API Key
# Get your API key from: https://account.shodan.io/
# Free tier: Very limited (1 query per month)
# Developer plan: $59/month for 10,000 query credits
# Enterprise plans: Higher limits available
SHODAN_API_KEY=your-shodan-api-key-here

# Cache TTL for Shodan responses (seconds)
# Default: 14400 (4 hours) - very long due to query costs
SHODAN_CACHE_TTL=14400

# Rate limiting for Shodan API (requests per minute)
# Very conservative due to API costs
SHODAN_RATE_LIMIT=1

# =============================================================================
# IPInfo API Configuration (BGP/ASN/Geolocation - Multi-Source Strategy)
# =============================================================================

# IPInfo API Token
# Get your free token from: https://ipinfo.io/signup
# Free tier: 50,000 requests per month (no credit card required)
# Without token: 1,000 requests per day (shared IP limit)
# Paid plans: Up to 250k requests/month with additional features
#
# Features included:
# - IP geolocation (city, region, country, coordinates)
# - ASN information (number, name, domain)
# - Hostname lookup
# - Company information
# - Anycast detection
#
# NOTE: IPInfo is now the PRIMARY source for BGP/ASN data (replacing BGPView)
IPINFO_API_KEY=your-ipinfo-token-here

# Cache TTL for IPInfo responses (seconds)
# Default: 7200 (2 hours) - BGP data changes infrequently
IPINFO_CACHE_TTL=7200

# Rate limiting for IPInfo API (requests per minute)
# Free tier with token: ~1666 requests/day = ~69/hour = ~1/min (conservative: 60/min)
# Without token: ~41/hour = ~0.7/min (conservative: 40/min)
IPINFO_RATE_LIMIT=60

# =============================================================================
# Subdomain Enumeration Settings
# =============================================================================

# Optional custom wordlist file (absolute or relative path)
SUBDOMAIN_WORDLIST_PATH=

# Maximum number of dictionary prefixes to probe (0 = unlimited)
SUBDOMAIN_DICTIONARY_LIMIT=2000

# Maximum number of discovered subdomains to analyze in depth
SUBDOMAIN_ANALYSIS_LIMIT=300

# Thread pool size for dictionary bruteforce
SUBDOMAIN_MAX_CONCURRENCY=60

# Enable/disable Certificate Transparency enumeration
ENABLE_CT_ENUMERATION=true
CT_LOG_PAGE_LIMIT=5

# Enable/disable passive DNS enumeration (hackertarget, bufferover)
ENABLE_PASSIVE_DNS_ENUMERATION=true

# Enable/disable Subfinder integration (requires subfinder binary)
ENABLE_SUBFINDER_ENUMERATION=false
SUBFINDER_BINARY_PATH=
SUBFINDER_TIMEOUT=120

# Enable/disable detailed analysis for each subdomain (DNS + HTTP checks)
# WARNING: This is VERY slow! For 100 subdomains, can take 30+ minutes
# Default: false (only return subdomain list, which is usually sufficient)
# Set to true only if you need IP addresses and HTTP status for each subdomain
ENABLE_SUBDOMAIN_DETAILED_ANALYSIS=false
